# WhatsApp Connector Service -- environment template.
# Copy to .env for local runs. NEVER commit the real .env file.

# Supabase service-role credentials (server-side only; never expose to
# any client, never used by the Vite app). Used exclusively to call the
# narrow whatsapp_connector_* RPCs -- this service never queries tables
# directly.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# AES-256-GCM key this service uses to encrypt Baileys' multi-file auth
# state before handing it to whatsapp_connector_store_session() as
# bytea. Must decode to exactly 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WHATSAPP_SESSION_ENCRYPTION_KEY=

# How often (ms) to poll notification_queue for new whatsapp-channel
# rows via whatsapp_connector_claim_next_batch().
QUEUE_POLL_INTERVAL_MS=5000

# How many queue rows to claim per poll tick.
QUEUE_BATCH_SIZE=10

# Optional overrides
WHATSAPP_TEMP_AUTH_DIR=./.baileys-auth-tmp
LOG_LEVEL=info
