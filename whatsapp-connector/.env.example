# WhatsApp Connector Service -- environment template.
# Copy to .env for local runs. NEVER commit the real .env file.

# ============================================================
# SUPABASE
# ============================================================

# Your real Supabase project URL.
# Example: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Supabase SERVICE ROLE key.
# IMPORTANT:
# - Server-side only.
# - Never expose this key to the Vite frontend.
# - Never use a VITE_ prefix.
# - Never commit this .env file to Git.
# - Never paste this key into client-side code.
#
# Get it from:
# Supabase Dashboard -> Project Settings -> API -> service_role / secret key
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# WHATSAPP SESSION ENCRYPTION
# ============================================================

# AES-256-GCM key this service uses to encrypt Baileys' multi-file auth
# state before handing it to whatsapp_connector_store_session() as
# bytea. Must decode to exactly 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# IMPORTANT: keep this key stable after WhatsApp sessions are created.
# Changing it later will prevent the connector from decrypting
# previously saved WhatsApp session credentials.
WHATSAPP_SESSION_ENCRYPTION_KEY=

# ============================================================
# QUEUE PROCESSING
# ============================================================

# How often the connector checks Supabase notification_queue for new
# WhatsApp messages. 5000 = every 5 seconds.
QUEUE_POLL_INTERVAL_MS=5000

# Maximum number of WhatsApp queue rows claimed on each poll.
QUEUE_BATCH_SIZE=10

# ============================================================
# BAILEYS LOCAL TEMP AUTH DIRECTORY
# ============================================================

# Temporary local directory used by Baileys while working with its
# multi-file authentication state. The persistent encrypted session is
# stored through the connector/Supabase session persistence flow, not
# this directory.
WHATSAPP_TEMP_AUTH_DIR=./.baileys-auth-tmp

# ============================================================
# LOGGING
# ============================================================

# trace | debug | info | warn | error. Keep "info" for normal operation.
LOG_LEVEL=info

# ============================================================
# SECURE WHATSAPP LINKS (booking QR / invoice)
# ============================================================

# Public origin used to build the booking-QR and invoice links sent in
# WhatsApp messages (templates.ts). Full origin, NO trailing slash.
# Production: https://mal3aby.app (real, purchased and bound domain --
#   this is what the deployed cloudflare/whatsapp-worker's wrangler.jsonc
#   actually sets as PUBLIC_APP_URL; this .env.example's own value below
#   stays a localhost default for LOCAL DEV convenience only, never used
#   in production).
# Example (local dev):  http://localhost:5173
#
# NEVER leave this pointing at localhost/127.0.0.1 in a deployed
# environment -- the customer's own phone opens this link, it must
# resolve on the public internet. Falls back to a localhost dev URL
# ONLY if unset, so local runs don't crash outright -- deployed
# environments MUST set this explicitly.
PUBLIC_APP_URL=http://localhost:5173

# ============================================================
# CONTAINER HEALTH / ORCHESTRATION (Cloudflare Containers only --
# harmless no-op on a bare Node/VPS host, nothing calls these there)
# ============================================================

# Port the internal health server (HealthServer.ts) listens on. Must
# match the Container class' `defaultPort` in the Worker/Durable
# Object config. Not related to any customer-facing traffic -- this
# service still has zero customer-facing inbound ports.
HEALTH_PORT=8080

# Shared secret the owning Cloudflare Durable Object presents (as the
# X-Internal-Token header) when polling GET /status for real
# per-account connection diagnostics. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave unset on a bare Node/VPS host -- /status then fails closed
# (403) for everyone, which is correct since nothing there should be
# calling it. /health and /ready remain open with no detail leaked
# regardless of this setting.
CONTAINER_INTERNAL_TOKEN=
