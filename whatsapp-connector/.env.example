# WhatsApp Connector Service — environment template.
# Copy to .env for local runs. NEVER commit the real .env file.

# Supabase service-role credentials (server-side only; never expose to
# any client). Used to sync connection state and read/write the
# notification_queue.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for signing requests between the trusted Supabase-side
# caller and this service. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONNECTOR_INTERNAL_SECRET=

# AES-256-GCM key for encrypting WhatsApp session auth state at rest.
# Must decode to exactly 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WHATSAPP_SESSION_ENCRYPTION_KEY=

# Optional overrides
PORT=8787
WHATSAPP_SESSIONS_DIR=./.sessions
WHATSAPP_TEMP_AUTH_DIR=./.baileys-auth-tmp
LOG_LEVEL=info
