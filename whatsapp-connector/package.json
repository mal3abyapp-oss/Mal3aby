{
  "name": "mala3by-whatsapp-connector",
  "version": "0.2.0",
  "description": "Persistent Node/TypeScript service that performs the real WhatsApp Multi-Device (Baileys) handshake and message delivery, behind a WhatsAppProvider adapter interface. Never runs inside the Vite client -- session credentials never leave this process. Talks to Supabase via narrow whatsapp_connector_* RPCs, never raw table access.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "test": "tsx --env-file=.env src/selfTest.ts",
    "test:media": "tsx src/mediaTest.ts",
    "test:send-reliability": "tsx src/sendReliabilityTest.ts"
  },
  "dependencies": {
    "@hapi/boom": "^9.1.4",
    "@supabase/supabase-js": "^2.47.0",
    "@whiskeysockets/baileys": "^6.7.9",
    "bidi-shaper": "^0.1.2",
    "pdfkit": "^0.19.1",
    "pino": "^9.4.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "pdfjs-dist": "^6.2.108",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
