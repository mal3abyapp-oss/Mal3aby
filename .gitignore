# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Environment
.env
.env.local
.env.*.local

# Supabase local
supabase/.branches/
supabase/.temp/

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Vite
*.local

# Testing
coverage/

# Scratch/QA scripts and credential fixtures -- never committed
.codex-temp/

# Temporary QA session files (never commit)
qa_session_temp.json
qa_signin_temp.mjs

# Playwright E2E (Phase 4) -- test artifacts and minted real Supabase
# Auth sessions (access/refresh tokens) for the QA fixture accounts.
# Sessions are disposable, re-minted via `npm run e2e:setup`, and must
# never be committed -- see e2e/setup/mint-qa-sessions.ts and
# E2E_TEST_STRATEGY.md.
/e2e/.auth-state/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Production database backups (Controlled Commercial Launch Gate,
# Phase 1/2) -- real schema/data dumps of the live production database.
# NEVER commit these: they contain real customer/financial/audit data
# once real tenants exist. See BACKUP_RUNBOOK.md for the real storage
# location (never solely inside this repo/machine either -- this
# .gitignore entry only prevents the catastrophic case of accidentally
# committing one to a public/shared Git history).
# The reusable operator scripts (extract_result.py, make_manifest.py,
# verify_manifest.py) are legitimate committed tooling, not backup data
# -- explicitly un-ignored below. Only the timestamped dump directories
# (e.g. backups/20260831T163434Z/) stay excluded.
/backups/*
!/backups/*.py
