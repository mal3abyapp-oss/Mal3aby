{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mala3by-whatsapp-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],

  // NO Secrets defined here as plaintext -- SUPABASE_SERVICE_ROLE_KEY,
  // WHATSAPP_SESSION_ENCRYPTION_KEY, CONTAINER_INTERNAL_TOKEN, and
  // MANAGEMENT_API_TOKEN are all set via `wrangler secret put <NAME>`
  // (or the Cloudflare dashboard's Worker Settings -> Variables and
  // Secrets, marked "Encrypt"), never in this file, never in git.
  // See MAL3ABY_CLOUDFLARE_PRODUCTION_ARCHITECTURE.md's Secrets section
  // for the exact `wrangler secret put` commands to run once account
  // access exists.
  "vars": {
    // Non-secret, safe to keep in version control. Real production
    // domain -- purchased and bound to the frontend Worker as a
    // Custom Domain, confirmed live via external HTTPS request before
    // this value was set (never invented ahead of the real domain
    // existing, per the standing "don't guess a domain name" rule).
    // This is what makes QR/verify links in real WhatsApp messages
    // resolve to https://mal3aby.app/qr/<token> and
    // https://mal3aby.app/verify/<token> instead of a workers.dev or
    // localhost URL.
    "SUPABASE_URL": "https://gxkrtlvpjwxhcqdisyob.supabase.co",
    "PUBLIC_APP_URL": "https://mal3aby.app"
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "WHATSAPP_ACCOUNT",
        "class_name": "WhatsAppAccountObject"
      }
    ]
  },

  // Durable Object migrations are append-only and version-tagged --
  // per directive rule 72, class names/IDs must never be renamed after
  // a production migration has shipped. v1 is the first (and, as of
  // this architecture doc, only) migration.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WhatsAppAccountObject"]
    }
  ],

  "containers": [
    {
      "class_name": "WhatsAppAccountObject",
      // Pre-built image reference (Cloudflare Registry), NOT a local
      // Dockerfile path -- built and pushed by
      // .github/workflows/whatsapp-container-build.yml on a
      // GitHub-hosted runner (real Docker, no local dependency), since
      // the local dev machine has no working Docker daemon.
      //
      // v8-jid-fix-real: TRUE ROOT CAUSE FIX for the WhatsApp send-hang
      // investigation. BaileysProvider.sendMessage() never normalized
      // its phone-number argument before building the WhatsApp JID
      // (`${phone}@s.whatsapp.net`) -- every real caller sources the
      // phone from notification_queue.recipient_phone /
      // customers.normalized_mobile, both of which store the E.164
      // "+"-prefixed form verbatim. A JID with a literal "+" baked in
      // is one WhatsApp's servers never send Baileys a usable response
      // for, so Baileys' own internal query() waited out its full ~60s
      // defaultQueryTimeoutMs ceiling on every queue-driven send.
      // Proven via a decisive, controlled A/B test on the SAME
      // connection/socket generation: send("971502061209") resolved in
      // 240ms; send("+971502061209") took 59,999ms and failed with
      // Baileys' own "Timed Out" error. Fix: BaileysProvider.ts now
      // exports toWhatsAppJid(), which strips all non-digit characters
      // before building the JID -- see its own doc comment and
      // sendMessage()'s class-level doc comment for the full
      // investigation trail (every other hypothesis tried --
      // USync-timeout-race, executeInitQueries collision, zombie
      // socket, queue/DB-layer delay, sequential-batch compounding --
      // was individually tested and ruled out first). An earlier image
      // built as "v8-jid-fix" (run 32163697016) was built from the
      // PRE-fix commit ac0ee03 due to a temporary git push permission
      // gap -- NOT deployed, recorded here so that tag is never
      // reused/trusted.
      // (Prior: v6-activity-expired, commit a111794, run 32142070765,
      // digest sha256:de839fc9fe9f9a986db0ab89ec5b21f5d2833f46e1aafe327432ba2b71210cd2 --
      // TRUE ROOT CAUSE FIX for the ~3-minute Durable Object eviction
      // cycle, entirely on the Worker/DO side
      // (WhatsAppAccountObject.ts's onActivityExpired() override,
      // @cloudflare/containers 0.0.13 -> 0.3.7).
      // v5-keepalive, commit 514758f, run 32138309680, digest
      // sha256:fe6f2f897b37200ee8e10b3d1614bc85875f2bf8f312ea64ca13cb05c4008ec6.
      // v4-diag, commit 30c0b72, run 32132856564, digest
      // sha256:41368361a181225433c87ae9d9e4568b32dd6d05d27108ac18626bba6717a157.
      // v3-timeout-fix, commit e359404, run 32131143382, digest
      // sha256:5a562395ea5696647fb81eb7a09aaffe505317f9af50bfe6ae1daf238bea1cf8.
      // v2-media, commit ba81fb1, run 32123381441, digest
      // sha256:a080242072d44d176db628c2580d278d5091302fe5df4415f15d109598c24b2c.
      // v1, commit 17c64406fee997bf7e626a1f30c1c6b30f4255ea, run
      // 32111047189, digest sha256:6a229c291d2580fc235d9fecd0f7d1d9eda6f9a14d00d80a1b12f2b4863ec08c.)
      // Traceable to: git commit 82aedbf, GitHub Actions run
      // 32172921915, tag v8-jid-fix-real, digest
      // sha256:6fbf385358dbc4ca9c515deb16ccc2db6a7a97a3d125f078b656d8f6063037b0.
      // v9, commit 59dc5de (status-write-race fencing, duplicate-message
      // fix, Secure Booking Link as primary UX, real Arabic invoice PDF
      // shaping fix, full English localization, public club booking
      // system), GitHub Actions run 32200344075, digest
      // sha256:8ffb88460a3b65610f3a4e80e45a1a97f15823c227433c364ef6a4f71767974e.
      // v10, commit f2b82a9 -- CRITICAL fix: per-contact Signal session
      // keys (state.keys.set) were never persisted to Postgres (only
      // top-level creds.json was, via creds.update). Every container
      // restart silently lost per-recipient session state, causing
      // messages to be accepted by WhatsApp's relay (real
      // provider_reference) but stuck "Waiting for this message" on the
      // recipient's device, undecryptable. GitHub Actions run
      // 32215525522, digest
      // sha256:f3ad7b0e5e64c9982f5b8f25f151ce73a5bc4b5d3180bcdb5dd3a83b9260008c.
      // To ship a new connector version: bump the tag in a new
      // workflow_dispatch run, then update this image reference to
      // match -- never silently reuse the same tag for different code
      // (the digest above is the actual content-addressed proof of
      // what's running, keep it in sync with the tag).
      "image": "registry.cloudflare.com/35ac10727701095866b16c276b4a33d1/mala3by-whatsapp-connector:f2b82a9",
      // One container instance per WhatsApp account (one Durable
      // Object = one container, directive rule 21's chosen model --
      // NOT a shared container serving multiple clubs, which would
      // widen blast radius for a single account's crash/misbehavior to
      // every other club sharing it).
      "max_instances": 1000,
      "instance_type": "basic",
      // A short grace period (not the bare default of 0): a container
      // that JUST reconnected to WhatsApp (e.g. right after a prior
      // replacement) should not be immediately eligible for another
      // rollout-triggered replacement mid-reconnect -- this avoids a
      // theoretical rollout racing a fresh reconnect. 30s is enough to
      // clear Baileys' own initial handshake window without
      // meaningfully slowing down real rollouts.
      "rollout_active_grace_period": 30
    }
  ],

  // Workers Logs + Durable Object logs -- free-tier eligible, no plan
  // upgrade required. Confirmed enabled live post-deploy.
  "observability": {
    "enabled": true
  }
}
