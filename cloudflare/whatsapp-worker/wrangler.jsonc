{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mala3by-whatsapp-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],

  // NO Secrets defined here as plaintext -- SUPABASE_SERVICE_ROLE_KEY,
  // WHATSAPP_SESSION_ENCRYPTION_KEY, CONTAINER_INTERNAL_TOKEN, and
  // MANAGEMENT_API_TOKEN are all set via `wrangler secret put <NAME>`
  // (or the Cloudflare dashboard's Worker Settings -> Variables and
  // Secrets, marked "Encrypt"), never in this file, never in git.
  // See MAL3ABY_CLOUDFLARE_PRODUCTION_ARCHITECTURE.md's Secrets section
  // for the exact `wrangler secret put` commands to run once account
  // access exists.
  "vars": {
    // Non-secret, safe to keep in version control. Real production
    // domain -- purchased and bound to the frontend Worker as a
    // Custom Domain, confirmed live via external HTTPS request before
    // this value was set (never invented ahead of the real domain
    // existing, per the standing "don't guess a domain name" rule).
    // This is what makes QR/verify links in real WhatsApp messages
    // resolve to https://mal3aby.app/qr/<token> and
    // https://mal3aby.app/verify/<token> instead of a workers.dev or
    // localhost URL.
    "SUPABASE_URL": "https://gxkrtlvpjwxhcqdisyob.supabase.co",
    "PUBLIC_APP_URL": "https://mal3aby.app"
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "WHATSAPP_ACCOUNT",
        "class_name": "WhatsAppAccountObject"
      }
    ]
  },

  // Durable Object migrations are append-only and version-tagged --
  // per directive rule 72, class names/IDs must never be renamed after
  // a production migration has shipped. v1 is the first (and, as of
  // this architecture doc, only) migration.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WhatsAppAccountObject"]
    }
  ],

  "containers": [
    {
      "class_name": "WhatsAppAccountObject",
      // Pre-built image reference (Cloudflare Registry), NOT a local
      // Dockerfile path -- built and pushed by
      // .github/workflows/whatsapp-container-build.yml on a
      // GitHub-hosted runner (real Docker, no local dependency), since
      // the local dev machine has no working Docker daemon.
      //
      // v8-jid-fix-real: TRUE ROOT CAUSE FIX for the WhatsApp send-hang
      // investigation. BaileysProvider.sendMessage() never normalized
      // its phone-number argument before building the WhatsApp JID
      // (`${phone}@s.whatsapp.net`) -- every real caller sources the
      // phone from notification_queue.recipient_phone /
      // customers.normalized_mobile, both of which store the E.164
      // "+"-prefixed form verbatim. A JID with a literal "+" baked in
      // is one WhatsApp's servers never send Baileys a usable response
      // for, so Baileys' own internal query() waited out its full ~60s
      // defaultQueryTimeoutMs ceiling on every queue-driven send.
      // Proven via a decisive, controlled A/B test on the SAME
      // connection/socket generation: send("971502061209") resolved in
      // 240ms; send("+971502061209") took 59,999ms and failed with
      // Baileys' own "Timed Out" error. Fix: BaileysProvider.ts now
      // exports toWhatsAppJid(), which strips all non-digit characters
      // before building the JID -- see its own doc comment and
      // sendMessage()'s class-level doc comment for the full
      // investigation trail (every other hypothesis tried --
      // USync-timeout-race, executeInitQueries collision, zombie
      // socket, queue/DB-layer delay, sequential-batch compounding --
      // was individually tested and ruled out first). An earlier image
      // built as "v8-jid-fix" (run 32163697016) was built from the
      // PRE-fix commit ac0ee03 due to a temporary git push permission
      // gap -- NOT deployed, recorded here so that tag is never
      // reused/trusted.
      // (Prior: v6-activity-expired, commit a111794, run 32142070765,
      // digest sha256:de839fc9fe9f9a986db0ab89ec5b21f5d2833f46e1aafe327432ba2b71210cd2 --
      // TRUE ROOT CAUSE FIX for the ~3-minute Durable Object eviction
      // cycle, entirely on the Worker/DO side
      // (WhatsAppAccountObject.ts's onActivityExpired() override,
      // @cloudflare/containers 0.0.13 -> 0.3.7).
      // v5-keepalive, commit 514758f, run 32138309680, digest
      // sha256:fe6f2f897b37200ee8e10b3d1614bc85875f2bf8f312ea64ca13cb05c4008ec6.
      // v4-diag, commit 30c0b72, run 32132856564, digest
      // sha256:41368361a181225433c87ae9d9e4568b32dd6d05d27108ac18626bba6717a157.
      // v3-timeout-fix, commit e359404, run 32131143382, digest
      // sha256:5a562395ea5696647fb81eb7a09aaffe505317f9af50bfe6ae1daf238bea1cf8.
      // v2-media, commit ba81fb1, run 32123381441, digest
      // sha256:a080242072d44d176db628c2580d278d5091302fe5df4415f15d109598c24b2c.
      // v1, commit 17c64406fee997bf7e626a1f30c1c6b30f4255ea, run
      // 32111047189, digest sha256:6a229c291d2580fc235d9fecd0f7d1d9eda6f9a14d00d80a1b12f2b4863ec08c.)
      // Traceable to: git commit 82aedbf, GitHub Actions run
      // 32172921915, tag v8-jid-fix-real, digest
      // sha256:6fbf385358dbc4ca9c515deb16ccc2db6a7a97a3d125f078b656d8f6063037b0.
      // v9, commit 59dc5de (status-write-race fencing, duplicate-message
      // fix, Secure Booking Link as primary UX, real Arabic invoice PDF
      // shaping fix, full English localization, public club booking
      // system), GitHub Actions run 32200344075, digest
      // sha256:8ffb88460a3b65610f3a4e80e45a1a97f15823c227433c364ef6a4f71767974e.
      // v10, commit f2b82a9 -- CRITICAL fix: per-contact Signal session
      // keys (state.keys.set) were never persisted to Postgres (only
      // top-level creds.json was, via creds.update). Every container
      // restart silently lost per-recipient session state, causing
      // messages to be accepted by WhatsApp's relay (real
      // provider_reference) but stuck "Waiting for this message" on the
      // recipient's device, undecryptable. GitHub Actions run
      // 32215525522, digest
      // sha256:f3ad7b0e5e64c9982f5b8f25f151ce73a5bc4b5d3180bcdb5dd3a83b9260008c.
      // v11, commit 235e37c -- adds POST /manage/:clubId/repair-session,
      // a single-contact Signal session repair (v10's persistence fix
      // only prevents FUTURE corruption; a session already stale before
      // v10 shipped needed an explicit repair). GitHub Actions run
      // 32216765843, digest
      // sha256:2d56d1f6d1c1c1f413bc6b8021b83035ad41318cad2b0110ec30ec684fd97875.
      // To ship a new connector version: bump the tag in a new
      // workflow_dispatch run, then update this image reference to
      // match -- never silently reuse the same tag for different code
      // (the digest above is the actual content-addressed proof of
      // what's running, keep it in sync with the tag).
      // v12, commit fa49505 -- MASTER OPERATIONAL SIMPLIFICATION
      // DIRECTIVE night-execution batch: government receipt fields
      // wired into WhatsApp message payloads (booking-confirmed-paid,
      // payment-received templates), payment method added to
      // invoice-PDF/message payload, real Arabic-tofu-box bug fixed on
      // the English-language invoice PDF layout (mixed-script values
      // now render through the correct vector renderer), booking
      // date/time + official receipt block added to the PDF. GitHub
      // Actions run 32355894455, digest
      // sha256:f37397cef615f5b49bc4247e4847d6a711df2f3ccc63c2a08f47f1122403619c.
      // v13, commit 91eed80 -- WHATSAPP PRODUCTION HARDENING batch:
      // duplicate-send mitigation on connector crash (see
      // 20260821160000 migration + BaileysProvider/QueueConsumer/
      // SupabaseSync/TenantConnectionManager/WhatsAppProvider changes --
      // provider_reference is now recorded the moment Baileys confirms
      // a text send, before media handling/the report round-trip, so
      // the stuck-processing recovery can tell an already-delivered
      // crashed send apart from a genuinely stuck one and refuse to
      // resend it). GitHub Actions run 32500705345.
      // v14, commit 0a33c27 -- INDEPENDENT AUDIT root-cause fix:
      // generation is no longer a plain in-process counter always
      // starting at 0 for a fresh process -- it is now atomically
      // allocated by the database itself
      // (whatsapp_connector_claim_generation, migration 20260821201000)
      // exactly once per process lifetime, closing a real permanent
      // status-write lockout confirmed live on club
      // b9178c0f-00b5-4c71-abec-b8772ffb8682 (last_generation reached
      // 17 through ordinary restart accumulation; a genuine WhatsApp
      // logout could then never be recorded, since no fresh process's
      // old-style counter could ever exceed 17 again). See
      // BaileysProvider.ts's dbGeneration field doc comment and the
      // migration's own comment for the full incident and fix.
      // GitHub Actions run 32515277302.
      // v15, commit a513976 -- QR-PAIRING-AFTER-LOGOUT fix: a
      // WhatsApp-side logout (connection.update's own loggedOut branch,
      // distinct from an explicit logout() call) never cleared the
      // local auth directory, only logout() did. The stale, WhatsApp-
      // invalidated creds.json survived on local disk, so every
      // subsequent "Link WhatsApp" pairing attempt re-read it and tried
      // to RESUME the dead identity instead of starting fresh --
      // WhatsApp's servers correctly rejected the resume with another
      // loggedOut before ever offering a QR. Confirmed live: 5
      // consecutive real pairing attempts on production each cycled
      // connecting -> logged_out in 2-6 seconds, zero QR ever emitted.
      // Fix: the loggedOut branch now also clears the local auth dir,
      // mirroring logout()'s own existing correct behavior. GitHub
      // Actions run 32522227116.
      // v16, commit b4c5477 -- BUSINESS MESSAGING AUDIT template fixes:
      // (1) partial payments now state the real outstanding balance
      // (payment-received/booking-confirmed-paid, AR+EN) instead of
      // only a translated status label with no number; (2) fields.sport
      // (a real free-text column) is now localized in Arabic messages
      // instead of showing the raw English value ("football" ->
      // "كرة قدم"), mirroring the frontend's own established fallback
      // pattern; (3) every template that shows a field name was
      // rendering that line TWICE -- fixed to render once. 43/43
      // connector tests passing (up from 33). GitHub Actions run
      // 32527946934.
      // v17, commit af325e9 -- WHATSAPP DELIVERY TRUTH fix (P0, real
      // production defect): notification_queue.status was set to
      // 'sent' the instant sendMessage()'s Promise resolved, which only
      // ever proved this connector wrote bytes to its own outbound
      // socket (confirmed by reading Baileys' own socket.js/
      // messages-send.js -- sendNode -> sendRawMessage, no server ack
      // involved, the returned message id is purely client-generated).
      // Real evidence exists via a genuine WhatsApp-server-originated
      // receipt (messages.update, proto.WebMessageInfo.Status),
      // correlated by the same key already stored as
      // provider_reference -- was simply never listened to. Adds a
      // messages.update listener -> whatsapp_connector_report_delivery_receipt()
      // RPC, populating new provider_accepted_at/delivered_at/read_at
      // columns. UI relabeled to match ("Sent" -> "Accepted by
      // WhatsApp", a new real "Delivered" status). GitHub Actions run
      // 32531345386.
      // v18, commit 41eaa07 -- WHATSAPP DELIVERY TRUTH investigation
      // continued: a real QA send to a newly-authorized, physically-
      // verified number (+971502061209, confirmed by the user checking
      // their own phone -- the message genuinely did NOT arrive despite
      // a real provider_accepted_at) needed a way to distinguish
      // "recipient not a registered WhatsApp account" from other
      // failure modes. Adds BaileysProvider.checkRegistration() -- a
      // real, read-only query against WhatsApp's own servers (Baileys
      // onWhatsApp(), confirmed present in the installed package,
      // sock.executeUSyncQuery() against a real USyncQuery -- not a
      // local/cached guess), reusing the club's already-live socket (no
      // second connection opened). Exposed as POST
      // /check-registration on the existing internal-token-gated
      // HealthServer, matching the established /repair-session pattern.
      // Also adds the delivery-receipt reconciliation/timeout policy
      // (whatsapp_delivery_confirmation_overdue(), STABLE and read-time-
      // only -- never written to storage, never regresses a later real
      // receipt; whatsapp_delivery_evidence_summary view,
      // security_invoker=true so per-club RLS is correctly enforced),
      // migration 20260822020000. GitHub Actions run 32536604129.
      // ROLLED BACK to v17, then RE-DEPLOYED as v18 (2026-08-22):
      // after deploying v18 and restarting the container twice,
      // notification_queue APPEARED stuck -- two real rows sat
      // 'pending'/attempts=0 for 5+ minutes while whatsapp_accounts
      // correctly showed status='connected'. Rolled back to v17 (image
      // af325e9) to isolate the cause. Isolation result (checked ~5
      // hours later, due to a real-world gap between scheduled checks):
      // BOTH rows eventually resolved correctly under v17 -- ae552732
      // was claimed and provider-accepted at 03:00:04 UTC, b806e0d1
      // correctly auto-cancelled (its source booking event had gone
      // stale in the meantime, exactly matching
      // whatsapp_connector_claim_next_batch()'s documented
      // still-valid-at-claim-time behavior). The container had then
      // gone back to sleep (sleepAfter='3m', confirmed via
      // /manage/:clubId/status returning {"status":"not_started"}) --
      // NOT stuck, just idle. The ~5-hour gap between checks means the
      // original "stuck for 5+ minutes" observation cannot be cleanly
      // attributed to v18 specifically vs. simply a slower-than-
      // expected post-restart settle window under either image -- the
      // v18 diff itself (git range 64c3f90..41eaa07) was reviewed and
      // is purely additive (a new checkRegistration() method + a new
      // /check-registration HTTP route), touching neither QueueConsumer
      // nor the connection-lifecycle code paths. Re-deployed v18 per
      // explicit user instruction, to be monitored more closely this
      // time. GitHub Actions run 32536604129 (image build).
      // v19, commit 826674c -- ROOT-CAUSE INVESTIGATION continued
      // (directive sections 5-6): checkRegistration() now also returns
      // the raw `lid` field from onWhatsApp() and the full unfiltered
      // rawResults array (connector-internal only, not forwarded past
      // the Worker's public /manage/* proxy). Confirmed via a full
      // source grep that the installed @whiskeysockets/baileys@6.7.24
      // has NO internal lidMapping store anywhere in the package --
      // isLid detection in messages-send.js is driven entirely by
      // whatever JID string the caller passes in, with no auto-upgrade
      // from a plain @s.whatsapp.net JID to @lid even if WhatsApp's
      // servers expect LID addressing for a given contact -- a real
      // candidate root cause for silent delivery failure to a
      // confirmed-registered number. New getSenderIdentity() reads the
      // connected socket's own authState.creds.me (id/lid/name) and
      // creds.platform directly, for comparison against
      // whatsapp_accounts.connected_phone_number. GitHub Actions run
      // 32564150867.
      // v20, commit 727cc12 -- ROOT CAUSE FIX (P0): PN/LID JID
      // mismatch. Live diagnostic evidence (checkRegistration()/
      // getSenderIdentity(), v19): sender account (201116505553,
      // platform "smba" -- a genuine WhatsApp Business API account) has
      // its own real LID (49779342049412:15@lid); QA recipient
      // (+971502061209, physically confirmed by the user to never
      // receive any of 3 real test sends despite each showing
      // provider_accepted_at) ALSO has a real LID
      // (214417870442550@lid). Confirmed via full source inspection:
      // the installed @whiskeysockets/baileys@6.7.24 has NO internal
      // LID-mapping store anywhere in the package -- the relay path's
      // LID auto-upgrade only ever applies to the SENDER's own devices,
      // never the recipient's, so every send in this investigation used
      // the recipient's plain PN JID verbatim even though their real
      // account has migrated to LID. Fix: sendMessage() now resolves
      // the real send-target JID via a real onWhatsApp() query
      // immediately before every send, preferring the recipient's
      // genuine LID over the constructed PN JID whenever WhatsApp's own
      // servers confirm one exists -- fails safe (query failure, 10s
      // timeout, no lid field) to the original PN JID unchanged, so
      // this can only match or improve on the pre-fix delivery
      // baseline. 91/91 connector tests pass (9 new, in
      // resolveRealSendJidTest.ts). GitHub Actions run 32564844096.
      // v21, commit 03a58cc -- ROOT-CAUSE INVESTIGATION continued: the
      // v20 PN/LID fix was deployed and re-tested, but the user
      // physically confirmed the post-fix send STILL never arrived on
      // the QA phone -- PN/LID was a real, confirmed structural gap,
      // but not (or not the complete) root cause of the delivery
      // failure. Moving to the next investigation layer: this connector
      // had a real, confirmed diagnostic blind spot -- it never
      // listened to messages.upsert at all (zero grep matches before
      // this fix), meaning it could not see ANY incoming message,
      // including a genuine WhatsApp-server account-risk/status notice
      // (a documented real phenomenon for Baileys/unofficial-client
      // accounts -- "your account may be using unauthorized tools" --
      // which arrives as an ordinary message from WhatsApp's own system
      // JID). Adds a safe-metadata-only messages.upsert listener + an
      // in-memory diagnostics ring buffer exposed via a new
      // /manage/:clubId/incoming-message-diagnostics route, so the next
      // real send can be checked for any such notice. GitHub Actions
      // run 32566136793.
      // v22, commit 9bb8157 -- ROOT-CAUSE INVESTIGATION continued,
      // directive section 9: getSenderIdentity() now also reports
      // AuthenticationCreds.registered (Baileys' own belief about
      // whether this device identity completed real WhatsApp-server
      // registration -- distinct from the socket merely being open)
      // and whether creds.account (the signed device-identity
      // credential required to be a trusted delivery target) is
      // present at all. Either being false/absent despite
      // status='connected' would be a concrete root-cause candidate for
      // "accepts sends locally, WhatsApp's servers never actually
      // deliver". GitHub Actions run 32566606604.
      "image": "registry.cloudflare.com/35ac10727701095866b16c276b4a33d1/mala3by-whatsapp-connector:9bb8157",
      // One container instance per WhatsApp account (one Durable
      // Object = one container, directive rule 21's chosen model --
      // NOT a shared container serving multiple clubs, which would
      // widen blast radius for a single account's crash/misbehavior to
      // every other club sharing it).
      "max_instances": 1000,
      "instance_type": "basic",
      // A short grace period (not the bare default of 0): a container
      // that JUST reconnected to WhatsApp (e.g. right after a prior
      // replacement) should not be immediately eligible for another
      // rollout-triggered replacement mid-reconnect -- this avoids a
      // theoretical rollout racing a fresh reconnect. 30s is enough to
      // clear Baileys' own initial handshake window without
      // meaningfully slowing down real rollouts.
      "rollout_active_grace_period": 30
    }
  ],

  // Workers Logs + Durable Object logs -- free-tier eligible, no plan
  // upgrade required. Confirmed enabled live post-deploy.
  "observability": {
    "enabled": true
  }
}
