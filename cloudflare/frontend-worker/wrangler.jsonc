{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mala3by-frontend",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],

  // Mal3aby's frontend is a pure client-side SPA (Vite + React Router,
  // no server-side rendering -- all real authorization is Supabase
  // RLS/RPCs, confirmed throughout this project's own architecture).
  // Workers Static Assets is the current Cloudflare-recommended
  // approach for this shape of project (confirmed via current
  // Cloudflare documentation research, Aug 2026: "Now that Workers
  // supports serving static assets... you should start with Workers"
  // for new projects).
  //
  // A minimal "main" Worker script IS used here -- not for any business
  // logic, but purely to inject security headers (HSTS, CSP,
  // X-Frame-Options, etc.) on every response, since static-assets-only
  // config has no request-time hook to add headers from. See src/index.ts.
  "main": "src/index.ts",
  "assets": {
    // Relative to this wrangler.jsonc -- the root frontend's own Vite
    // build output (../../dist, i.e. the existing `npm run build` at
    // the repo root, completely unchanged by this Cloudflare work).
    "directory": "../../dist",

    // SPA fallback: any request that doesn't match a real built file
    // (e.g. /qr/<token>, /verify/<token>, /app/bookings, /portal/...)
    // serves index.html with a 200 status so React Router's own
    // client-side routing takes over -- this is what makes deep-link
    // reload (directive rule 42) work in production the same way Vite
    // dev server's own historyApiFallback already does locally.
    "not_found_handling": "single-page-application",

    "binding": "ASSETS",

    // CRITICAL: Cloudflare's default routing serves a request directly
    // from static assets WITHOUT invoking the Worker script at all when
    // the path matches a real file (confirmed via current Cloudflare
    // documentation, and by a real local repro in this repo's own
    // history -- an earlier version of this config omitted
    // run_worker_first and security headers were silently absent on
    // every static-asset response and on "/", verified via `wrangler
    // dev` + curl, then fixed here). run_worker_first: true forces
    // EVERY request through src/index.ts's fetch handler first, so
    // header injection applies universally, not just to SPA-fallback
    // routes.
    "run_worker_first": true
  },

  // Non-secret config the Worker script reads to build its CSP
  // connect-src/frame-ancestors rules against the real Supabase project
  // origin, without hardcoding it in source.
  "vars": {
    "SUPABASE_URL": "https://gxkrtlvpjwxhcqdisyob.supabase.co"
  },

  // Workers Logs -- free-tier eligible, no plan upgrade required.
  // Ingests invocation logs, errors, and uncaught exceptions for up to
  // 7 days, queryable from the Cloudflare dashboard. Confirmed enabled
  // live post-deploy.
  "observability": {
    "enabled": true
  },

  // Production domain, purchased and confirmed under this Cloudflare
  // account. Both the apex and www are bound as Custom Domains (not
  // plain Routes) -- Cloudflare auto-manages the DNS record and issues
  // an Advanced Certificate for each, no manual DNS/cert step needed.
  // www is bound to the SAME Worker rather than left unrouted or made
  // a separate site -- src/index.ts issues a 308 to the apex for any
  // request arriving on the www host, so www never becomes an
  // independent origin.
  "routes": [
    { "pattern": "mal3aby.app", "custom_domain": true },
    { "pattern": "www.mal3aby.app", "custom_domain": true }
  ],

  // Keep workers.dev alive as a technical fallback/debugging address --
  // NOT the customer-facing canonical URL (that's mal3aby.app), but
  // useful for verifying a deploy independent of DNS/domain state.
  // wrangler defaults this to disabled once any custom domain/route is
  // configured, so it must be set explicitly to keep it available.
  "workers_dev": true

  // Rate limiting for public token-verification routes (/qr/:token,
  // /verify/:token): best configured via Cloudflare Rate Limiting Rules
  // in the dashboard once a live domain exists, so real traffic
  // patterns (not guesses) inform the threshold -- see
  // MAL3ABY_DEPLOYMENT_RUNBOOK.md section 6.
}
