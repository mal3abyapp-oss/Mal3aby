# Copy to .env.e2e.local and fill in real values. Never commit
# .env.e2e.local. Used ONLY by `npm run e2e:setup`
# (e2e/setup/mint-qa-sessions.ts) to mint real, browser-usable Supabase
# Auth sessions for the QA fixture accounts -- NEVER by the app itself
# and NEVER by playwright.config.ts / any spec file directly.
#
# See E2E_TEST_STRATEGY.md "Credential-minting strategy" for the full
# explanation of why this is safe: generateLink()/verifyOtp() mint a
# session without ever reading or resetting a QA account's real
# password, and this key never reaches a browser context.

# Same value as .env.local's VITE_SUPABASE_URL.
VITE_SUPABASE_URL=

# SERVICE ROLE KEY -- NEVER commit this file with a real value filled
# in. NEVER put this key in .env.local, vite.config.ts, or any file
# that ships to the browser. Get it from the Supabase dashboard
# (Project Settings -> API -> service_role secret) or via the Supabase
# MCP tooling this project's sessions already use. Local/CI use only.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: the real page origin a minted session's storageState should
# be scoped to. Defaults to the local Vite dev server. Set this when
# minting sessions to use against a deployed target (the workers.dev
# fallback URL, a future staging host) instead of localhost.
# E2E_APP_ORIGIN=http://localhost:5173

# Optional: base URL Playwright itself navigates to. Defaults to the
# local Vite dev server (auto-started). Set to run the suite against a
# real deployed target instead -- see STAGING_ARCHITECTURE.md.
# E2E_BASE_URL=http://localhost:5173
